function! CopyVisualButNoContent()
  let start_line = line("'<")
  let end_line   = line("'>")
  normal! \<Esc>
  let file_path = expand("%:p:~")
  if start_line == end_line
    let text = file_path . ":" . start_line
  else
    let text = file_path . ":" . start_line . "," . end_line
  endif
  let @+ = text
  echo "Copied: " . text
endfunction
xnoremap <silent> Y :<c-u>call CopyVisualButNoContent()<cr>
nnoremap <silent> <leader>yp :let @+ = expand("%:p:~")<cr>

