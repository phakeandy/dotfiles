#!/bin/sh
# IBus panel wrapper —— 只放大 ibus 候选框（panel 进程）的字体，不影响其它 GTK 程序。
#
# 背景：Debian ibus 1.5.32 + GTK 3.24 下，候选框既不吃 `use-custom-font`
# （label { font-size: Npt } 注入无效），也不吃 XSETTINGS 的 gtk-font-name；
# 实测只有 GDK_DPI_SCALE 能放大它（见 ../xfce/README.md）。
#
# 调大小：改下面的默认值，或临时用 IBUS_PANEL_SCALE=1.4 ibus restart 试。
#   1.0 = 原始，1.4 = 温和，1.7 = 适配 ~160PPI 的 4K 屏，2.0 = 更大
: "${IBUS_PANEL_SCALE:=1.7}"
export GDK_DPI_SCALE="$IBUS_PANEL_SCALE"
exec /usr/libexec/ibus-ui-gtk3 "$@"
