#!/usr/bin/env bash
# sesh session picker.
#
# Opened from tmux with prefix + C-f (tmux.conf -> display-popup). Lists tmux
# sessions, zoxide directories, sesh.toml configs and tmuxinator projects, then
# connects to the selection, creating the session if it doesn't exist yet.
#
# Source keys:  ^a all  ^t tmux  ^g configs  ^x zoxide  ^f find dirs  ^d kill
# fzf hands the whole line ("<icon> <name>") to sesh, which strips the icon;
# {2..} (fields after the icon) is used where the raw name is needed.

set -euo pipefail

# fd is installed as fdfind on Debian; ~/bin/fd should already point at it.
FD=$(command -v fd || command -v fdfind || true)

sel=$(
  sesh list --icons -d -c -t -T |
    fzf \
      --ansi --no-sort \
      --border-label ' sesh ' \
      --prompt '⚡  ' \
      --header ' ^a all  ^t tmux  ^g configs  ^x zoxide  ^f find  ^d kill' \
      --bind 'tab:down,btab:up' \
      --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons -d -c -t -T)' \
      --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list --icons -d -t)' \
      --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list --icons -d -c -T)' \
      --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list --icons -d -z)' \
      --bind "ctrl-f:change-prompt(🔎  )+reload(${FD:-fd} -H -d 2 -t d -E .Trash . ~)" \
      --bind 'ctrl-d:execute-silent(tmux kill-session -t {2..})+reload(sesh list --icons -d -c -t -T)' \
      --preview-window 'right:55%:wrap' \
      --preview 'sesh preview --watch {2..}'
) || exit 0

[ -z "$sel" ] && exit 0

exec sesh connect --switch "$sel"
