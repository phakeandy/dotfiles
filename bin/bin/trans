#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = [
#     "openai>=1.30",
# ]
# ///

import os
import sys
from openai import OpenAI

SYSTEM_PROMPT = "Translate to Chinese.  DO NOT output any description, and explaination."

DEFAULT_BASE_URL = "https://api.deepseek.com"
DEFAULT_MODEL = "deepseek-v4-flash"

def main() -> int:
    api_key = os.environ.get("DEEPSEEK_APIKEY")
    if not api_key:
        print("ERROR: 未设置 DEEPSEEK_API_KEY 环境变量。", file=sys.stderr)
        return 1

    model = os.environ.get("DEEPSEEK_MODEL", DEFAULT_MODEL)
    base_url = os.environ.get("DEEPSEEK_BASE_URL", DEFAULT_BASE_URL)
    system_prompt = os.environ.get("SYSTEM_PROMPT", SYSTEM_PROMPT)

    prompt = ""
    filepath = None
    positional = []
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-f", "--file"):
            if i + 1 >= len(args):
                print("ERROR: -f/--file 需要一个文件名。", file=sys.stderr)
                return 1
            filepath = args[i + 1]
            i += 2
        elif a.startswith("--file="):
            filepath = a[len("--file="):]
            i += 1
        else:
            positional.append(a)
            i += 1

    if filepath is not None:
        try:
            with open(filepath, encoding="utf-8") as fh:
                prompt = fh.read()
        except OSError as exc:
            print(f"ERROR: 无法读取文件 {filepath}：{exc}", file=sys.stderr)
            return 1
    elif positional:
        prompt = positional[0]
    else:
        prompt = sys.stdin.read()    
    if not prompt.strip():
        print("ERROR: Input 为空", file=sys.stderr)
        return 1

    client = OpenAI(api_key=api_key, base_url=base_url)

    messages = []
    if system_prompt:
        messages.append({"role": "system", "content": system_prompt})
    messages.append({"role": "user", "content": prompt})

    try:
        response = client.chat.completions.create(
            model=model,
            messages=messages,
            reasoning_effort="none",
        )
    except Exception as exc:
        print(f"请求失败：{exc}", file=sys.stderr)
        return 1

    content = response.choices[0].message.content
    if content is not None:
        print(content)
    return 0


if __name__ == "__main__":
    sys.exit(main())
