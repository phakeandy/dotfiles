{
  "lastChangelogVersion": "1.0.4",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "outputPad": 1,
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-web-access",
    "https://github.com/ayghri/i-have-adhd",
    {
      "source": "git:github.com/phakeandy/pi-tmux-subagents",
      "extensions": []
    },
    "npm:pi-subagents"
  ],
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true,
    "imageWidthCells": 60
  },
  "tuiMode": "fullscreen",
  "editorPaddingX": 0,
  "extensions": [
    "+extensions/quiet-tools.ts"
  ],
  "prompts": [
    "-prompts/justdowhatiwant.md"
  ],
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-sol": "medium",
    "openai-codex/gpt-6-sol": "medium",
    "openai-codex/gpt-6.1-sol": "medium"
  },
  "powerline": {
    "preset": "nerd",
    "placement": "above"
  }
}