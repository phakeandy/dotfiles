gtk-titlebar = false
font-family = "Iosevka Nerd Font Mono"
font-family = "Noto Sans CJK SC"
font-feature = -calt, -liga, -dlig
font-size = 12
# TODO: not work
window-inherit-font-size = false
keybind  = ctrl+0=set_font_size:12

cursor-style = block
cursor-style-blink = false
mouse-scroll-multiplier = 0.8
shell-integration-features = no-cursor

mouse-hide-while-typing = true

#keybind = alt+h=goto_split:left
#keybind = alt+j=goto_split:bottom
#keybind = alt+k=goto_split:top
#keybind = alt+l=goto_split:right
keybind = ctrl+shift+l=goto_split:previous

#ghossty has no alt_send_esc config.
keybind = alt+a=esc:a
keybind = alt+i=esc:i
keybind = alt+i=esc:i
keybind = alt+h=esc:h
keybind = alt+j=esc:j
keybind = alt+k=esc:k
keybind = alt+l=esc:l
keybind = alt+shift+o=esc:O

foreground=#ffffff
background=#000000
background-opacity=1.0

palette = 0=#1e2320
palette = 1=#705050
palette = 2=#60b48a
palette = 3=#dfaf8f
palette = 4=#506070
palette = 5=#dc8cc3
palette = 6=#8cd0d3
palette = 7=#dcdccc

palette = 8=#709080
palette = 9=#dca3a3
palette = 10=#c3bf9f
palette = 11=#f0dfaf
palette = 12=#94bff3
palette = 13=#ec93d3
palette = 14=#93e0e3
palette = 15=#ffffff
